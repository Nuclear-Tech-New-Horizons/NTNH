name: Nightly Release

on:
  schedule:
    - cron: '0 0 * * *'  # 00:00 UTC daily
  workflow_dispatch:
    inputs:
      force_nightly_number:
        description: 'Override nightly number (01-99). Leave empty for auto.'
        required: false
        default: ''

# Prevent overlapping nightly runs
concurrency:
  group: nightly-release
  cancel-in-progress: false

jobs:
  build:
    name: Build & Changelog
    runs-on: ubuntu-24.04   # NOTE: swap for blacksmith-4vcpu-ubuntu-2404 if you need your custom runner
    outputs:
      version: ${{ steps.version.outputs.version }}
      nightly_num: ${{ steps.version.outputs.nightly_num }}
      tag_name: ${{ steps.version.outputs.tag_name }}
      release_name: ${{ steps.version.outputs.release_name }}
      commit_range: ${{ steps.changelog.outputs.commit_range }}
      commits_body: ${{ steps.changelog.outputs.commits_body }}
      prev_stable: ${{ steps.changelog.outputs.prev_stable }}
      zip_name: ${{ steps.zip.outputs.zip_name }}
    
    steps:
      - name: Checkout updates/upcoming
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          ref: updates/upcoming

      - name: Calculate version and nightly number
        id: version
        run: |
          set -euo pipefail

          # Extract base version: "NTNH 2.9.0" -> "2.9.0"
          BASE_VERSION=$(head -n 1 config/txloader/forceload/mainmenu/version.txt | sed 's/NTNH //;s/ .*//')
          echo "version=$BASE_VERSION" >> "$GITHUB_OUTPUT"
          echo "Base version: $BASE_VERSION"

          # Nightly number calculation
          if [ -n "${{ github.event.inputs.force_nightly_number }}" ]; then
            printf -v NIGHTLY_NUM "%02d" "$((10#${{ github.event.inputs.force_nightly_number }}))"
            echo "Forced nightly number: $NIGHTLY_NUM"
          else
            # GTNH-style: use Git's version sort to find the highest existing nightly tag
            LAST_TAG=$(git tag -l "${BASE_VERSION}-nightly-*" --sort=-v:refname | head -n1 || true)
            if [ -n "$LAST_TAG" ]; then
              LAST_NUM=$(echo "$LAST_TAG" | sed 's/.*-nightly-//')
              NIGHTLY_NUM=$(printf "%02d" $((10#$LAST_NUM + 1)))
              echo "Last nightly: $LAST_TAG -> Next: $NIGHTLY_NUM"
            else
              NIGHTLY_NUM=01
              echo "No previous nightly. Starting at 01"
            fi
          fi

          echo "nightly_num=$NIGHTLY_NUM" >> "$GITHUB_OUTPUT"
          echo "tag_name=${BASE_VERSION}-nightly-${NIGHTLY_NUM}" >> "$GITHUB_OUTPUT"
          echo "release_name=NTNH ${BASE_VERSION} Nightly ${NIGHTLY_NUM}" >> "$GITHUB_OUTPUT"

      - name: Generate changelog data
        id: changelog
        run: |
          set -euo pipefail

          VERSION="${{ steps.version.outputs.version }}"
          NIGHTLY_NUM="${{ steps.version.outputs.nightly_num }}"

          # --- Previous stable release (for compare link) ---
          # GTNH approach: latest non-nightly tag that is not the current version
          PREV_STABLE=$(git tag -l --sort=-v:refname | grep -v 'nightly' | grep -vx "$VERSION" | head -n1 || true)
          if [ -z "$PREV_STABLE" ]; then
            PREV_STABLE="initial"
          fi
          echo "prev_stable=$PREV_STABLE" >> "$GITHUB_OUTPUT"

          # --- Commit range for this nightly ---
          if [ "$NIGHTLY_NUM" = "01" ]; then
            # First nightly: diff since last stable tag reachable on this branch
            LAST_STABLE=$(git tag -l --merged HEAD --sort=-v:refname | grep -v 'nightly' | grep -vx "$VERSION" | head -n1 || true)
            if [ -n "$LAST_STABLE" ]; then
              COMMIT_RANGE="${LAST_STABLE}..HEAD"
            else
              COMMIT_RANGE="HEAD~30..HEAD"  # fallback
            fi
          else
            PREV_NUM=$(printf "%02d" $((10#$NIGHTLY_NUM - 1)))
            PREV_TAG="${VERSION}-nightly-${PREV_NUM}"
            if git rev-parse "$PREV_TAG" >/dev/null 2>&1; then
              COMMIT_RANGE="${PREV_TAG}..HEAD"
            else
              # Fallback if previous nightly tag is missing/reset
              if [ "$PREV_STABLE" != "initial" ]; then
                COMMIT_RANGE="${PREV_STABLE}..HEAD"
              else
                COMMIT_RANGE="HEAD~30..HEAD"
              fi
            fi
          fi
          echo "range=$COMMIT_RANGE" >> "$GITHUB_OUTPUT"

          # --- Commit list ---
          if [ "$COMMIT_RANGE" = "HEAD~30..HEAD" ]; then
            COMMITS=$(git log -30 --pretty=format:'- `%h` %an: %s' || true)
          else
            COMMITS=$(git log "$COMMIT_RANGE" --pretty=format:'- `%h` %an: %s' || true)
          fi

          if [ -z "$COMMITS" ]; then
            COMMITS="_No new commits since the previous release._"
          fi

          # Multiline output for GitHub Actions
          {
            echo "commits_body<<EOF"
            echo "$COMMITS"
            echo "EOF"
          } >> "$GITHUB_OUTPUT"

      - name: Stage release files with version bumps
        run: |
          set -euo pipefail

          VERSION="${{ steps.version.outputs.version }}"
          NIGHTLY_NUM="${{ steps.version.outputs.nightly_num }}"

          # Create a clean staging copy. The working tree is NEVER modified.
          mkdir -p staging/NTNH
          cp -r .[!.]* ..?* * staging/NTNH/ 2>/dev/null || true
          rm -rf staging/NTNH/.git staging/NTNH/.github staging/NTNH/staging

          # Inject nightly version into the staging copy only
          sed -i "1s/$/ Nightly-${NIGHTLY_NUM}/" staging/NTNH/config/txloader/forceload/mainmenu/version.txt

          # Update connection checker greeting
          FULL_VERSION=$(head -n 1 staging/NTNH/config/txloader/forceload/mainmenu/version.txt | sed 's/NTNH //')
          sed -i "s/Welcome to NTNH.*/Welcome to NTNH ${FULL_VERSION}!/" staging/NTNH/config/concheckrmd.cfg

          echo "Version.txt:"
          cat staging/NTNH/config/txloader/forceload/mainmenu/version.txt

      - name: Create ZIP archive
        id: zip
        run: |
          set -euo pipefail

          ZIP_NAME="NTNH-${{ steps.version.outputs.version }}-Nightly-${{ steps.version.outputs.nightly_num }}-Native.zip"
          cd staging
          zip -r "../${ZIP_NAME}" NTNH -x "*.git/*" ".github/*"
          cd ..

          if [ ! -f "$ZIP_NAME" ]; then
            echo "::error::ZIP creation failed"
            exit 1
          fi

          echo "zip_name=$ZIP_NAME" >> "$GITHUB_OUTPUT"
          ls -lh "$ZIP_NAME"

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: nightly-build-${{ steps.version.outputs.tag_name }}
          path: ${{ steps.zip.outputs.zip_name }}
          if-no-files-found: error
          retention-days: 3

      - name: Build summary
        if: success() || failure()
        run: |
          echo "# Nightly Build Summary" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "| Field | Value |" >> "$GITHUB_STEP_SUMMARY"
          echo "| --- | --- |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Version | ${{ steps.version.outputs.version }} |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Nightly | ${{ steps.version.outputs.nightly_num }} |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Tag | ${{ steps.version.outputs.tag_name }} |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Commit Range | ${{ steps.changelog.outputs.commit_range }} |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Prev Stable | ${{ steps.changelog.outputs.prev_stable }} |" >> "$GITHUB_STEP_SUMMARY"

  test:
    name: Validate Build
    needs: build
    runs-on: ubuntu-24.04
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: nightly-build-${{ needs.build.outputs.tag_name }}

      - name: ZIP integrity & structure checks
        run: |
          set -euo pipefail
          ZIP="${{ needs.build.outputs.zip_name }}"

          echo "Testing ZIP integrity..."
          unzip -t "$ZIP"

          echo "Checking critical files..."
          if ! unzip -l "$ZIP" | grep -q "config/txloader/forceload/mainmenu/version.txt"; then
            echo "::error::version.txt missing from archive"
            exit 1
          fi
          if ! unzip -l "$ZIP" | grep -q "config/concheckrmd.cfg"; then
            echo "::error::concheckrmd.cfg missing from archive"
            exit 1
          fi

          # Optional: verify version.txt has the nightly suffix
          UNPACKED=$(mktemp -d)
          unzip -q "$ZIP" -d "$UNPACKED"
          if ! grep -q "Nightly-${{ needs.build.outputs.nightly_num }}" "$UNPACKED/NTNH/config/txloader/forceload/mainmenu/version.txt"; then
            echo "::error::version.txt missing nightly suffix"
            exit 1
          fi
          rm -rf "$UNPACKED"

          echo "All validation checks passed."

      # GTNH-style extension point: add server startup test here if you want
      # - name: Server startup test
      #   run: |
      #     unzip "${{ needs.build.outputs.zip_name }}" -d /tmp/server
      #     ... run server and verify it reaches "Done" state ...

  release:
    name: Publish Release
    needs: [build, test]
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: nightly-build-${{ needs.build.outputs.tag_name }}

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ needs.build.outputs.tag_name }}
          name: ${{ needs.build.outputs.release_name }}
          body: |
            ⚠️ **Warning:** This is a development/testing build and may contain bugs and/or break your world save. Use at your own risk!

            ## Version Info
            - **Base:** `${{ needs.build.outputs.version }}`
            - **Nightly:** `${{ needs.build.outputs.nightly_num }}`
            - **Build Run:** [#${{ github.run_number }}](https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }})

            ## Changes since last release
            ${{ needs.build.outputs.commits_body }}

            [View full diff](https://github.com/${{ github.repository }}/compare/${{ needs.build.outputs.commit_range }})

            ## Changelog
            [Full changelog](https://github.com/${{ github.repository }}/blob/updates/upcoming/CHANGELOG.md) comparing [${{ needs.build.outputs.prev_stable }}](https://github.com/${{ github.repository }}/releases/tag/${{ needs.build.outputs.prev_stable }}) to [updates/upcoming](https://github.com/${{ github.repository }}/compare/${{ needs.build.outputs.prev_stable }}...updates/upcoming)
          draft: false
          prerelease: true
          files: ${{ needs.build.outputs.zip_name }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Release summary
        if: success()
        run: |
          echo "# Release Published" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "- **Tag:** ${{ needs.build.outputs.tag_name }}" >> "$GITHUB_STEP_SUMMARY"
          echo "- **Release:** ${{ needs.build.outputs.release_name }}" >> "$GITHUB_STEP_SUMMARY"
          echo "- **URL:** https://github.com/${{ github.repository }}/releases/tag/${{ needs.build.outputs.tag_name }}" >> "$GITHUB_STEP_SUMMARY"
