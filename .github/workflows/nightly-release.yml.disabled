name: Nightly Release

on:
  schedule:
    - cron: '0 0 * * *'  # Runs every day at 00:00 UTC
  workflow_dispatch:  # Allow manual trigger as backup

jobs:
  nightly-release:
    runs-on: blacksmith-4vcpu-ubuntu-2404
    permissions:
      contents: write
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
      
      - name: Checkout updates/upcoming branch
        run: |
          git fetch origin updates/upcoming
          git checkout updates/upcoming
          git pull origin updates/upcoming
      
      - name: Get version and calculate nightly number
        id: version
        run: |
          FULL_LINE=$(head -n 1 config/txloader/forceload/mainmenu/version.txt)
          VERSION=$(echo "$FULL_LINE" | sed 's/NTNH //;s/ .*//')
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "Current base version: $VERSION"
          
          LAST_NIGHTLY=$(git tag -l "${VERSION}-nightly-*" 2>/dev/null | sed "s/${VERSION}-nightly-//" | sort -V | tail -n1)
          
          if [ -z "$LAST_NIGHTLY" ]; then
            NIGHTLY_NUM=01
          else
            NIGHTLY_NUM=$(printf "%02d" $((10#${LAST_NIGHTLY} + 1)))
          fi
          
          echo "number=$NIGHTLY_NUM" >> $GITHUB_OUTPUT
          echo "Nightly number: $NIGHTLY_NUM"
      
      - name: Get commits since last nightly release
        id: commits
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          NIGHTLY_NUM="${{ steps.version.outputs.number }}"
          
          if [ "$NIGHTLY_NUM" = "01" ]; then
            LAST_TAG=$(git tag -l --merged HEAD 2>/dev/null | grep -v nightly | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1)
            if [ -z "$LAST_TAG" ]; then
              COMMIT_RANGE="HEAD"
            else
              COMMIT_RANGE="${LAST_TAG}..HEAD"
            fi
          else
            PREV_NIGHTLY_NUM=$(printf "%02d" $((10#${NIGHTLY_NUM} - 1)))
            LAST_NIGHTLY_TAG="${VERSION}-nightly-${PREV_NIGHTLY_NUM}"
            COMMIT_RANGE="${LAST_NIGHTLY_TAG}..HEAD"
          fi
          
          COMMITS=$(git log "$COMMIT_RANGE" --pretty=format:'- `%h` - %an: %s' 2>/dev/null)
          
          {
            echo "commits<<EOF"
            echo "$COMMITS"
            echo "EOF"
            echo "range=$COMMIT_RANGE"
          } >> $GITHUB_OUTPUT
      
      - name: Get version range for changelog
        id: changelog
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          
          # Find the most recent stable release that is strictly less than the current version
          # Use ALL tags (not just --merged HEAD) so we correctly find the latest stable release
          # even if it was tagged on a different branch (e.g., main, hotfix)
          PREV_STABLE=$(git tag -l 2>/dev/null | grep -v nightly | while read -r tag; do
            padded_tag=$(echo "$tag" | awk -F. '{printf "%04d.%04d.%04d\n", $1, $2, $3}')
            padded_current=$(echo "$VERSION" | awk -F. '{printf "%04d.%04d.%04d\n", $1, $2, $3}')
            if [ "$padded_tag" \< "$padded_current" ]; then
              echo "$tag"
            fi
          done | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1)
          
          if [ -z "$PREV_STABLE" ]; then
            PREV_STABLE="initial"
          fi
          
          echo "prev_stable=$PREV_STABLE" >> $GITHUB_OUTPUT
          echo "current_stable=$VERSION" >> $GITHUB_OUTPUT
          echo "Changelog will compare: $PREV_STABLE to $VERSION"
      
      - name: Update version.txt
        run: |
          sed -i "1s/$/ Nightly-${{ steps.version.outputs.number }}/" config/txloader/forceload/mainmenu/version.txt
          echo "Updated version.txt:"
          cat config/txloader/forceload/mainmenu/version.txt
      
      - name: Update concheckrmd.cfg
        run: |
          FULL_VERSION=$(head -n 1 config/txloader/forceload/mainmenu/version.txt | sed 's/NTNH //')
          sed -i "s/Welcome to NTNH.*/Welcome to NTNH ${FULL_VERSION}!/" config/concheckrmd.cfg
          echo "Updated concheckrmd.cfg:"
          grep "Custom greeting message text" config/concheckrmd.cfg
      
      - name: Create package directory
        run: |
          mkdir -p /tmp/package
          cp -r . /tmp/package/NTNH
      
      - name: Create ZIP archive
        id: zip
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          ZIP_NAME="NTNH-${VERSION}-Nightly-${{ steps.version.outputs.number }}-Native.zip"
          cd /tmp/package
          zip -r "$ZIP_NAME" NTNH -x "*.git/*" ".github/*"
          mv "$ZIP_NAME" /tmp/
          echo "zip_name=$ZIP_NAME" >> $GITHUB_OUTPUT
          echo "Created: $ZIP_NAME"
          ls -lh /tmp/*.zip
      
      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.version.outputs.version }}-nightly-${{ steps.version.outputs.number }}
          name: NTNH ${{ steps.version.outputs.version }} Nightly ${{ steps.version.outputs.number }}
          body: |
            ⚠️ **Warning:** This is a development/testing build and may contain bugs and/or break your world save. Use at your own risk!
            
            ## Changes since last daily release:
            ${{ steps.commits.outputs.commits }}
            
            [Full difference](https://github.com/${{ github.repository }}/compare/${{ steps.commits.outputs.range }})
            
            ## Changelog
            
            [Full changelog](https://github.com/${{ github.repository }}/blob/updates/upcoming/CHANGELOG.md) comparing [${{ steps.changelog.outputs.prev_stable }}](https://github.com/${{ github.repository }}/releases/tag/${{ steps.changelog.outputs.prev_stable }}) to [updates/upcoming](https://github.com/${{ github.repository }}/compare/${{ steps.changelog.outputs.prev_stable }}...updates/upcoming)
          draft: false
          prerelease: true
          files: /tmp/${{ steps.zip.outputs.zip_name }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
